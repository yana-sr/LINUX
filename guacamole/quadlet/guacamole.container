[Unit]
Description=Apache Guacamole web app (behind Cloudflare Access)
After=guacd.service
Requires=guacd.service

[Container]
ContainerName=guacamole
Image=docker.io/guacamole/guacamole@sha256:f344085e618bb05e22b964b0208dbd06d3468275bac70206f93805245e067b40
Network=host
Environment=GUACD_HOSTNAME=127.0.0.1
Environment=GUACD_PORT=4822
Volume=%h/guacamole/user-mapping.xml:/etc/guacamole/user-mapping.xml:ro,Z

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
